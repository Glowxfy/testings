local function copyTable(t)
    local result = {}
    for key, value in pairs(t) do result[key] = value end
    return result
end
local function normalSettings(t)
    local out = copyTable(DEFAULT)
    if type(t) == 'table' then
        for key in pairs(DEFAULT) do
            if type(t[key]) == 'boolean' then out[key] = t[key] end
        end
    end
    return out
end
local function cleanName(s)
    s = tostring(s or ''):gsub('[%c]', ''):gsub('^%s+', ''):gsub('%s+$', '')
    return s:sub(1, 28)
end
local function fileAPI(name)
    if type(env[name]) == 'function' then return env[name] end
    if name == 'readfile' and type(readfile) == 'function' then return readfile end
    if name == 'writefile' and type(writefile) == 'function' then return writefile end
    return nil
end
local readFile, writeFile = fileAPI('readfile'), fileAPI('writefile')
local diskAvailable = readFile ~= nil and writeFile ~= nil
local SAVE_FILE = 'StealAnEgg_HubV2_Configs.json'
local profiles = {Default = copyTable(DEFAULT)}
local activeProfile = 'Default'
local settings = copyTable(DEFAULT)

if diskAvailable then
    local ok, raw = pcall(readFile, SAVE_FILE)
    if ok and type(raw) == 'string' then
        local decodeOK, decoded = pcall(HTTP.JSONDecode, HTTP, raw)
        if decodeOK and type(decoded) == 'table' and type(decoded.profiles) == 'table' then
            local loaded = {}
            for name, state in pairs(decoded.profiles) do
                if type(name) == 'string' and name ~= '' and type(state) == 'table' then
                    loaded[name] = normalSettings(state)
                end
            end
            if next(loaded) then profiles = loaded end
            if type(decoded.active) == 'string' and profiles[decoded.active] then
                activeProfile = decoded.active
            else
                activeProfile = next(profiles) or 'Default'
            end
            settings = normalSettings(profiles[activeProfile])
        end
    end
end
local function persist()
    profiles[activeProfile] = copyTable(settings)
    if not diskAvailable then return false, 'Executor file API not available' end
    local ok, json = pcall(HTTP.JSONEncode, HTTP, {
        version = 2, active = activeProfile, profiles = profiles
    })
    if not ok then return false, 'Could not encode config JSON' end
    local wrote, reason = pcall(writeFile, SAVE_FILE, json)
    return wrote, reason
end

local connections = {}
