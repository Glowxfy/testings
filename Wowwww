local function new(class, parent, props)
    local obj = Instance.new(class)
    for k, v in pairs(props or {}) do obj[k] = v end
    obj.Parent = parent
    return obj
end
local function corner(p, r) return new('UICorner', p, {CornerRadius = UDim.new(0, r)}) end
local function stroke(p, width, forText)
    return new('UIStroke', p, {
        Thickness = width, Color = C.border,
        ApplyStrokeMode = forText and Enum.ApplyStrokeMode.Contextual
            or Enum.ApplyStrokeMode.Border
    })
end
local function gradient(p, colors)
    return new('UIGradient', p, {
        Rotation = 90,
        Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, colors[1]),
            ColorSequenceKeypoint.new(0.49, colors[2]),
            ColorSequenceKeypoint.new(1, colors[3])
        })
    })
end
local function label(p, value, x, y, w, h, fontSize, opts)
    opts = opts or {}
    local v = new('TextLabel', p, {
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(x, y), Size = UDim2.fromOffset(w, h),
        Text = value, TextColor3 = opts.color or C.white,
        Font = opts.font or Enum.Font.GothamBlack,
        TextSize = fontSize, TextXAlignment = opts.align or Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Center,
        TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = opts.z or 12
    })
    if opts.outline ~= false then stroke(v, opts.stroke or 2.3, true) end
    return v
end
local function panel(p, x, y, w, h, color, z)
    local v = new('Frame', p, {
        Position = UDim2.fromOffset(x, y), Size = UDim2.fromOffset(w, h),
        BackgroundColor3 = color or C.dark, BorderSizePixel = 0, ZIndex = z or 7
    })
    corner(v, 5); stroke(v, 2.5)
    return v
end
local function checkers(p, w, h, cell, transparency, z)
    local group = new('Frame', p, {
        Name = 'CheckerboardFX', BackgroundTransparency = 1,
        Position = UDim2.fromOffset(-cell * 2, -cell * 2),
        Size = UDim2.fromOffset(w + cell * 5, h + cell * 5),
        ZIndex = z
    })
    local columns = math.ceil((w + cell * 5) / cell)
    local rows = math.ceil((h + cell * 5) / cell)
    for iy = 0, rows do
        for ix = 0, columns do
            if (ix + iy) % 2 == 0 then
                new('Frame', group, {
                    Position = UDim2.fromOffset(ix * cell, iy * cell),
                    Size = UDim2.fromOffset(cell, cell),
                    BackgroundColor3 = C.border,
                    BackgroundTransparency = math.min(0.98,
                        transparency + ix / math.max(1, columns) * 0.17),
                    BorderSizePixel = 0, ZIndex = z
                })
            end
        end
    end
    return group
end
