local function getExecutorAPI(name)
    if type(env[name]) == 'function' then return env[name] end
    if name == 'writefile' then return type(writefile) == 'function' and writefile or nil end
    if name == 'isfile' then return type(isfile) == 'function' and isfile or nil end
    if name == 'getcustomasset' then return type(getcustomasset) == 'function' and getcustomasset or nil end
    if name == 'getsynasset' then return type(getsynasset) == 'function' and getsynasset or nil end
    return nil
end

local B64_CHARS = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/'
local B64_LOOKUP = {}
for i=1,#B64_CHARS do
    B64_LOOKUP[string.byte(B64_CHARS,i)] = i-1
end
local function decodeBiomeBase64(source)
    if type(source) ~= 'string' or #source % 4 ~= 0 then return nil end
    local chunks = {}
    for i=1,#source,4 do
        local a = B64_LOOKUP[string.byte(source,i)]
        local b = B64_LOOKUP[string.byte(source,i+1)]
        local c = B64_LOOKUP[string.byte(source,i+2)]
        local d = B64_LOOKUP[string.byte(source,i+3)]
        if a == nil or b == nil then return nil end
        local number = a*262144 + b*4096 + (c or 0)*64 + (d or 0)
        chunks[#chunks+1] = string.char(math.floor(number/65536)%256)
        if c ~= nil then chunks[#chunks+1] = string.char(math.floor(number/256)%256) end
        if d ~= nil then chunks[#chunks+1] = string.char(number%256) end
    end
    return table.concat(chunks)
end

local BIOME_IMAGE_ASSETS = {}
local function resolveBiomeImage(routeId)
    if BIOME_IMAGE_ASSETS[routeId] then return BIOME_IMAGE_ASSETS[routeId] end
    local imageId = IMAGE_ASSET_OVERRIDES[routeId]
    if type(imageId) == 'string' and imageId ~= '' then
        -- Accept both a numeric Roblox image ID and a full content URI.
        local uri = imageId:match('^%d+$') and ('rbxassetid://' .. imageId) or imageId
        BIOME_IMAGE_ASSETS[routeId] = uri
        return uri
    end

    local image = EMBEDDED_BIOME_IMAGES[routeId]
    if not image then return nil end
    local assetLoader = getExecutorAPI('getcustomasset') or getExecutorAPI('getsynasset')
    local writeImage = getExecutorAPI('writefile')
    if not assetLoader then return nil end
    local path = image.file
    -- Avoid repeated writes on rerun when the file already exists.
    local exists = getExecutorAPI('isfile')
    local filePresent = false
    if exists then
        local ok, present = pcall(exists,path)
        filePresent = ok and present == true
    end
    if writeImage and not filePresent then
        local bytes = decodeBiomeBase64(image.data)
        if bytes then
            local success, err = pcall(writeImage, path, bytes)
            if not success then warn('[SAE Hub] Thumbnail write failed: ' .. tostring(err)) end
        end
    end
    local ok, contentUri = pcall(assetLoader, path)
    if ok and type(contentUri) == 'string' and contentUri ~= '' then
        BIOME_IMAGE_ASSETS[routeId] = contentUri
        return contentUri
    end
    return nil
end

