local dragging, touchInput, dragStart, originPosition
track(header.InputBegan:Connect(function(input)
    local typ = input.UserInputType
    if typ ~= Enum.UserInputType.MouseButton1 and typ ~= Enum.UserInputType.Touch then return end
    if input.Position.X >= close.holder.AbsolutePosition.X - 8 then return end
    dragging = true
    touchInput = typ == Enum.UserInputType.Touch and input or nil
    dragStart = input.Position
    local absolute = outer.AbsolutePosition
    local sz = outer.AbsoluteSize
    originPosition = Vector2.new(absolute.X + sz.X/2, absolute.Y + sz.Y/2)
end))
track(UIS.InputChanged:Connect(function(input)
    if not dragging or not dragStart then return end
    if touchInput then
        if input ~= touchInput then return end
    elseif input.UserInputType ~= Enum.UserInputType.MouseMovement then
        return
    end
    local delta = input.Position - dragStart
    local v = viewport()
    local halfW, halfH = W*uiScale.Scale/2, H*uiScale.Scale/2
    local center = originPosition + Vector2.new(delta.X, delta.Y)
    outer.Position = UDim2.fromOffset(
        math.clamp(center.X, halfW + 5, math.max(halfW+5,v.X-halfW-5)),
        math.clamp(center.Y, halfH + 5, math.max(halfH+5,v.Y-halfH-5))
    )
end))
track(UIS.InputEnded:Connect(function(input)
    if (touchInput and input == touchInput) or
        (not touchInput and input.UserInputType == Enum.UserInputType.MouseButton1) then
        dragging = false
        touchInput = nil
    end
end))

