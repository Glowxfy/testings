end

local function keepButterflyNetWaypoint()
    if not butterflyNetActive then return end
    local character = player.Character
    local root = character and character:FindFirstChild('HumanoidRootPart')
    if not root then return end
    root.CFrame = CFrame.new(ButterflyNetTarget) * root.CFrame.Rotation
    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero
end

local function getButterflyPromptPosition(prompt)
    local parent = prompt and prompt.Parent
    if not parent then return nil end
    if parent:IsA('Attachment') then
        return parent.WorldPosition
    elseif parent:IsA('BasePart') then
        return parent.Position
    elseif parent:IsA('Model') then
        return parent:GetPivot().Position
    end
    return nil
end

local function getButterflyPromptDistance(prompt)
    if not prompt or not prompt.Parent or not prompt.Enabled then return nil end
    local character = player.Character
    local root = character and character:FindFirstChild('HumanoidRootPart')
    local camera = WS.CurrentCamera
    if not root or not camera then return nil end
    local position = getButterflyPromptPosition(prompt)
    if not position then return nil end
    local distance = (root.Position - position).Magnitude
    if distance > prompt.MaxActivationDistance then return nil end
    local _, onScreen = camera:WorldToViewportPoint(position)
    if not onScreen then return nil end
    return distance
end

local function findButterflyPrompt()
    local nearest, nearestDistance
    local nearestClaim, nearestClaimDistance
    nearestDistance, nearestClaimDistance = math.huge, math.huge
    for prompt in pairs(butterflyVisiblePrompts) do
        local distance = getButterflyPromptDistance(prompt)
        if distance then
            if isButterflyClaimPrompt(prompt) then
                if distance < nearestClaimDistance then
                    nearestClaim, nearestClaimDistance = prompt, distance
                end
            elseif distance < nearestDistance then
                nearest, nearestDistance = prompt, distance
            end
        end
    end
    if BUTTERFLY_CLAIM_ONLY then return nearestClaim end
    return nearestClaim or nearest
end

local function pressButterflyPrompt(prompt)
    if not butterflyNetActive or not prompt or not prompt.Parent then return end
    butterflyLastAttemptedPrompt = prompt
    pcall(function()
        local firePrompt = type(fireproximityprompt) == 'function'
            and fireproximityprompt or env.fireproximityprompt
        if type(firePrompt) == 'function' then
            firePrompt(prompt)
        else
            prompt:InputHoldBegin()
            task.wait(math.max(prompt.HoldDuration, 0.05) + 0.1)
            prompt:InputHoldEnd()
        end
    end)
end

local function startButterflyAutoClaim()
    if butterflyNetActive or hasButterflyNetTool() then return end
    local previousStop = env.WaypointAutoClaimStop
    if type(previousStop) == 'function' and previousStop ~= stopButterflyNetLock then
        pcall(previousStop)
    end
    butterflyNetRunId = butterflyNetRunId + 1
    local thisRun = butterflyNetRunId
    butterflyNetActive = true
    butterflyLastAttemptedPrompt = nil
    table.clear(butterflyVisiblePrompts)
    env.WaypointAutoClaimStop = stopButterflyNetLock
    refreshButterflyButton()
    keepButterflyNetWaypoint()
    table.insert(butterflyNetConnections, RS.Heartbeat:Connect(keepButterflyNetWaypoint))
    table.insert(butterflyNetConnections,
        ButterflyNetPromptService.PromptShown:Connect(function(prompt)
            if butterflyNetActive then butterflyVisiblePrompts[prompt] = true end
        end))
    table.insert(butterflyNetConnections,
        ButterflyNetPromptService.PromptHidden:Connect(function(prompt)
            butterflyVisiblePrompts[prompt] = nil
        end))
    table.insert(butterflyNetConnections,
        ButterflyNetPromptService.PromptTriggered:Connect(function(prompt, who)
            if not butterflyNetActive then return end
            if who and who ~= player then return end
            -- Stop on a successful prompt trigger, as before.
            -- Ownership is checked from inventory, not assumed from this event.
            if isButterflyClaimPrompt(prompt)
                or prompt == butterflyLastAttemptedPrompt then
                stopButterflyNetLock()
            end
        end))

    task.spawn(function()
        task.wait(0.3)
        if not butterflyNetActive or butterflyNetRunId ~= thisRun then return end
        -- Add prompts that were visible before PromptShown was connected.
        for _, object in ipairs(WS:GetDescendants()) do
            if not butterflyNetActive or butterflyNetRunId ~= thisRun then return end
            if object:IsA('ProximityPrompt') and getButterflyPromptDistance(object) then
                butterflyVisiblePrompts[object] = true
            end
        end
        while butterflyNetActive and butterflyNetRunId == thisRun do
            -- Inventory can update after the claim interaction; stop promptly.
            if hasButterflyNetTool() then
                stopButterflyNetLock()
                break
            end
            local prompt = findButterflyPrompt()
            if prompt then pressButterflyPrompt(prompt) end
            task.wait(BUTTERFLY_AUTO_PRESS_DELAY)
        end
    end)
end

