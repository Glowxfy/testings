-- V2.1-style route runner: use the saved pre-route pivot only for the
-- hidden egg-pickup round trip. Manual routes finish at route.Last.
-- This routine intentionally does NOT make a third teleport or continually
-- force the character's position after the second hop.
local function runRoute(route)
    if teleportBusy then
        setStatus('A TELEPORT ROUTE IS ALREADY RUNNING', true)
        return
    end

    local char = getAliveCharacter()
    if not char then
        setStatus('CHARACTER IS NOT READY', true)
        return
    end
    if typeof(route.First) ~= 'Vector3' then
        setStatus('INVALID FIRST WAYPOINT', true)
        return
    end
    if route.SingleOnly ~= true and route.ReturnPrevious ~= true and typeof(route.Last) ~= 'Vector3' then
        setStatus('INVALID SECOND WAYPOINT', true)
        return
    end

    -- Capture the entire original pivot BEFORE teleporting.
    -- This is only used as the destination when ReturnPrevious = true.
    local previous = char:GetPivot()
    local orientation = previous.Rotation
    local first = CFrame.new(route.First) * orientation
    -- SAFE ZONE is a single-step route and has no second destination.
    -- Only calculate a second CFrame for routes that actually need it.
    local destination
    if route.SingleOnly ~= true then
        if route.ReturnPrevious == true then
            destination = previous
        else
            destination = CFrame.new(route.Last) * orientation
        end
    end

    setRouteBusy(true)
    setStatus('TELEPORTING TO ' .. route.Name .. ' ...')

    task.spawn(function()
        if not moveTo(char, first) then
            setStatus('FIRST TELEPORT FAILED', true)
            setRouteBusy(false)
            return
        end

        print(string.format('[SAE Hub] %s: first -> (%.0f, %.0f, %.0f)',
            route.Name, route.First.X, route.First.Y, route.First.Z))
        if route.SingleOnly == true then
            setStatus('ROUTE COMPLETED: ' .. route.Name)
            print(string.format('[SAE Hub] %s: single-step route completed', route.Name))
            setRouteBusy(false)
            return
        end
        task.wait(route.Delay)

        if not gui.Parent then
            setRouteBusy(false)
            return
        end
        if player.Character ~= char then
            setStatus('CHARACTER CHANGED DURING TELEPORT', true)
            setRouteBusy(false)
            return
        end

        if moveTo(char, destination) then
            if route.ReturnPrevious == true then
                setStatus('RETURNED TO PREVIOUS LOCATION')
                print('[SAE Hub] AUTO SPAWN: returned to original pivot')
            else
                setStatus('ROUTE COMPLETED: ' .. route.Name)
                print(string.format('[SAE Hub] %s: second -> (%.0f, %.0f, %.0f)',
                    route.Name, route.Last.X, route.Last.Y, route.Last.Z))
                showSecondWaypointSplash()
            end
        else
            setStatus('SECOND TELEPORT FAILED', true)
        end
        setRouteBusy(false)
    end)
end
-- =======================================
-- AUTO EGG DELIVERY: CONFIRMED E -> OLD ROUND TRIP -> DELIVERY (V4)
-- =======================================
-- You choose the egg manually and press E; a confirmed carry starts the job.
-- Restore the original (513,68,-363) -> 0.5s -> original pivot round trip
-- BEFORE trying Sena's external delivery or the standalone walk fallback.
-- The local teleports can be server-corrected. We recheck carry afterwards:
-- if the server dropped the egg, do NOT pretend a deposit was successful.
-- Sena's full movement runtime is not bundled; use it if already available.
-- Fallback uses quicker normal walking and does not forcibly drop eggs.
-- Keep AutoEggReturn as the original saved-config key.
local EGG_ROUNDTRIP_WAYPOINT = Vector3.new(513, 68, -363)
local EGG_ROUNDTRIP_WAIT = 0.5 -- original hub timing
local EGG_DELIVERY_FAST_SPEED = 500 -- temporary speed during fallback walk
local EGG_BANK_CENTER = Vector3.new(542.93, 71.5, -405.58)
local EGG_BANK_RADIUS_XZ = 23
local EGG_BANK_RADIUS_Y = 17
local EGG_MOVEMENT_TIMEOUT = 780 -- Enough for legitimate walking across the long map
local EGG_DEPOSIT_WAIT = 12
local EGG_STUCK_TIMEOUT = 7
local EGG_MOVE_REFRESH = 0.18
local EGG_RETRY_DELAY = 6
local eggStateModule
local deliveryConnection
local deliveryRunId = 0
local deliveringUid = nil
local deliveryAttempted = {}
local deliveryPathfinding = game:GetService('PathfindingService')
-- Readable in getgenv().__SAE_Hub_DeliveryInfo if debugging is required.
local deliveryInfo = {stage='IDLE', uid=nil, reason=nil, mode=nil, distance=nil, fieldState=nil}
env.__SAE_Hub_DeliveryInfo = deliveryInfo

local function deliveryStatus(stage, detail, isError)
    deliveryInfo.stage = stage
    if detail ~= nil then deliveryInfo.reason = tostring(detail) end
    if not gui.Parent then return end
    local message = 'EGG: ' .. stage
    if detail ~= nil and detail ~= '' then message = message .. ' - ' .. tostring(detail) end
    status.Text = message
    status.TextColor3 = isError and C.redHi or C.greenHi
end

local function deliveryRecord(uid)
    if not eggStateModule or type(eggStateModule.ReadFieldEgg) ~= 'function' then
        return nil, false
    end
    local ok, record = pcall(eggStateModule.ReadFieldEgg, uid)
    return ok and type(record) == 'table' and record or nil, ok
end

local function deliveryIsCarrying(uid)
    local rec = deliveryRecord(uid)
    return rec ~= nil and rec.State == 'Carried'
        and tonumber(rec.CarrierUserId) == player.UserId, rec
end

local function deliveryOwnerHas(uid)
    if not eggStateModule then return false end
    -- Sena's inventory display reads GetOwnerRuntimeRecords(UserId).
    -- Some game revisions also expose ReadOwnerEggs. Support both.
    for _, method in ipairs({'GetOwnerRuntimeRecords','ReadOwnerEggs'}) do
        if type(eggStateModule[method]) == 'function' then
            local ok, records = pcall(eggStateModule[method], player.UserId)
            if ok and type(records) == 'table' then
                if records[uid] ~= nil then return true end
                local list = records.Records or records
                if type(list) == 'table' then
                    for key, rec in pairs(list) do
                        if tostring(key) == uid then return true end
                        if type(rec) == 'table' and rec.Uid == uid then return true end
                    end
                end
            end
        end
    end
    return false
end

local function deliveryObserve(uid)
    local rec, available = deliveryRecord(uid)
    deliveryInfo.fieldState = rec and rec.State or (available and 'MISSING' or 'UNAVAILABLE')
    if deliveryOwnerHas(uid) or (rec and rec.State == 'Claimed') then
        return 'OWNED', rec
    end
    if rec then
        if rec.State == 'Carried' and tonumber(rec.CarrierUserId) == player.UserId then
            return 'CARRIED', rec
        elseif rec.State == 'Carried' then
            return 'OTHER_CARRIER', rec
        elseif rec.State == 'Dropped' or rec.State == 'Slot' then
            return 'DROPPED', rec
        end
        return tostring(rec.State or 'UNKNOWN'), rec
    end
    if available then return 'MISSING', nil end
    return 'UNAVAILABLE', nil
end

local function deliveryReachedCenter(pos, goal)
    local d = pos-goal
    return Vector2.new(d.X,d.Z).Magnitude <= 5
        and math.abs(d.Y) <= 9
end

local function deliveryInBank(pos)
    local d = pos - EGG_BANK_CENTER
    return Vector2.new(d.X, d.Z).Magnitude <= EGG_BANK_RADIUS_XZ
        and math.abs(d.Y) <= EGG_BANK_RADIUS_Y
end

local function deliveryCanContinue(runId, char)
    return gui.Parent ~= nil and deliveryRunId == runId
        and settings.AutoEggReturn == true
        and player.Character == char and getAliveCharacter() == char
end

-- Original hub behavior: on a *confirmed* manual E pickup, briefly go to
-- the old Safe Zone waypoint and restore the exact pre-trip CFrame.
-- Note: the pre-trip CFrame is captured immediately after the carry is verified.
-- We perform this before Sena starts to avoid fighting its movement runtime.
local function deliveryOldRoundTrip(uid, runId, char, previousPivot)
    if not deliveryCanContinue(runId,char) then return false,'ROUND TRIP CANCELLED' end
    if deliveryObserve(uid) ~= 'CARRIED' then
        return false,'EGG NO LONGER CARRIED BEFORE ROUND TRIP'
    end
    local first = CFrame.new(EGG_ROUNDTRIP_WAYPOINT) * previousPivot.Rotation
    deliveryInfo.mode = 'ORIGINAL ROUND TRIP'
    deliveryStatus('OLD ROUND TRIP: SAFE ZONE')
    if not moveTo(char, first) then
        return false,'OLD ROUND TRIP: FIRST TELEPORT FAILED'
    end
    task.wait(EGG_ROUNDTRIP_WAIT)
    if not deliveryCanContinue(runId,char) then return false,'ROUND TRIP CANCELLED' end
    deliveryStatus('OLD ROUND TRIP: RESTORING POSITION')
    if not moveTo(char,previousPivot) then
        return false,'OLD ROUND TRIP: RETURN TELEPORT FAILED'
    end
    -- Allow the server's carry state to settle before starting Sena.
    local endCheck = os.clock() + 1.25
    repeat
        if not deliveryCanContinue(runId,char) then return false,'ROUND TRIP CANCELLED' end
        local state = deliveryObserve(uid)
        if state == 'OWNED' then return true,'DEPOSIT CONFIRMED IN ROUND TRIP' end
        if state == 'DROPPED' or state == 'OTHER_CARRIER' then
            return false,'EGG LOST DURING ROUND TRIP ('..state..')'
        end
        -- Do not launch a new delivery while a server correction is pending.
        if state == 'CARRIED' and os.clock() >= endCheck then
            return true,'ROUND TRIP COMPLETE; STILL CARRYING'
        end
        task.wait(0.10)
    until os.clock() >= endCheck
    return deliveryObserve(uid) == 'CARRIED','CARRY NOT CONFIRMED AFTER ROUND TRIP'
end

-- Sena raycasts for the ground (_resolveSafeCFrame) rather than blindly
-- placing the root at the nominal region center. We only use the raycast to
-- identify a WALK destination, never to move the player's CFrame.
local function deliveryWalkDestination(char, humanoid, bank)
    local origin = bank + Vector3.new(0, 130, 0)
    local filter = {char}
    for _ = 1, 8 do
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.FilterDescendantsInstances = filter
        params.IgnoreWater = true
        local hit = WS:Raycast(origin, Vector3.new(0,-350,0), params)
        if not hit then break end
        if hit.Instance.CanCollide then
            local root = char:FindFirstChild('HumanoidRootPart')
            local offset = root and root.Size.Y * 0.5 + math.max(humanoid.HipHeight,0.5) or 3.2
            return Vector3.new(bank.X, hit.Position.Y + offset, bank.Z)
        end
        table.insert(filter, hit.Instance)
    end
    return bank
end

-- Pathfinding is only a recovery for an ordinary MoveTo getting stuck at
-- terrain/collisions. A failed path does not cause any teleport or egg drop.
local function deliveryAvoidObstacle(char, hum, dest, runId, uid)
    local root = char:FindFirstChild('HumanoidRootPart')
    if not root then return false end
    local start = root.Position
    local heading = Vector3.new(dest.X-start.X, 0, dest.Z-start.Z)
    if heading.Magnitude < 10 then return false end
    local localTarget = start + heading.Unit * math.min(90, heading.Magnitude)
    local ok, path = pcall(function()
        local p = deliveryPathfinding:CreatePath({AgentRadius=2.5,AgentHeight=5,AgentCanJump=true,WaypointSpacing=12})
        p:ComputeAsync(start, localTarget)
        return p
    end)
    if not ok or not path or path.Status ~= Enum.PathStatus.Success then return false end
    local waypoints = path:GetWaypoints()
    if #waypoints < 2 then return false end
    deliveryStatus('NAVIGATING OBSTACLE')
    for i = 2, math.min(#waypoints, 12) do
        local waypoint = waypoints[i]
        local expires = os.clock() + 4
        while os.clock() < expires and deliveryCanContinue(runId,char) do
            if deliveryObserve(uid) ~= 'CARRIED' then return true end
            local p = char:FindFirstChild('HumanoidRootPart')
            if not p then return false end
            if (p.Position-waypoint.Position).Magnitude <= 5 then break end
            if waypoint.Action == Enum.PathWaypointAction.Jump then hum.Jump = true end
            hum:MoveTo(waypoint.Position)
            task.wait(0.25)
        end
    end
    return true
end

local function deliveryWalkHome(uid, runId, char)
    local hum = char:FindFirstChildOfClass('Humanoid')
    local root = char:FindFirstChild('HumanoidRootPart')
    if not hum or not root then return false, 'CHARACTER NOT READY' end
    local target = deliveryWalkDestination(char, hum, EGG_BANK_CENTER)
    local deadline = os.clock() + EGG_MOVEMENT_TIMEOUT
    local lastPos = root.Position
    local lastProgress = os.clock()
    local reroutes = 0
    deliveryInfo.mode = 'NORMAL WALK'
    -- Unlike PivotTo, Humanoid:MoveTo uses the game's ordinary movement.
    while deliveryCanContinue(runId,char) and os.clock() < deadline do
        local state = deliveryObserve(uid)
        if state == 'OWNED' then return true, 'DEPOSIT CONFIRMED' end
        if state == 'MISSING' then
            -- Sena accepts missing field records as successful returns;
            -- here we keep it tentative until inventory confirms ownership.
            return false, 'FIELD EGG REMOVED; CHECK INVENTORY'
        end
        if state == 'DROPPED' or state == 'OTHER_CARRIER' then
            return false, 'CARRY LOST ('..state..')'
        end
        if state ~= 'CARRIED' then
            return false, 'CARRY STATE '..tostring(state)
        end
        root = char:FindFirstChild('HumanoidRootPart')
        if not root then return false, 'ROOT MISSING' end
        local here = root.Position
        local dist = Vector2.new(here.X-target.X,here.Z-target.Z).Magnitude
        deliveryInfo.distance = math.floor(dist)
        if deliveryReachedCenter(here,target) then
            -- Get to the actual deposit center (not merely inside a broad
            -- region-radius check) before waiting for bank confirmation.
            hum:MoveTo(target)
            return nil, 'ARRIVED'
        end
        if (here-lastPos).Magnitude > 3 then
            lastPos = here
            lastProgress = os.clock()
        elseif os.clock()-lastProgress > EGG_STUCK_TIMEOUT then
            reroutes += 1
            if reroutes > 4 then return false,'BLOCKED/ROLLED BACK; WALK TO BASE MANUALLY' end
            local rerouted = deliveryAvoidObstacle(char,hum,target,runId,uid)
            lastProgress = os.clock()
            lastPos = (char:FindFirstChild('HumanoidRootPart') or root).Position
            if not rerouted then
                deliveryStatus('MOVEMENT BLOCKED', 'try a clear route',true)
                task.wait(1)
            end
        end
        local remaining = Vector3.new(target.X-here.X,0,target.Z-here.Z)
        local lookAhead = math.clamp(hum.WalkSpeed*0.7,35,160)
        local nextTarget
        if remaining.Magnitude > lookAhead then
            local nextFlat = here + remaining.Unit*lookAhead
            nextTarget = Vector3.new(nextFlat.X, here.Y, nextFlat.Z)
        else
            nextTarget = target
        end
        pcall(hum.MoveTo,hum,nextTarget)
        if math.floor(os.clock()*2)%4==0 then
            deliveryStatus('RETURNING HOME', tostring(math.floor(dist))..' studs')
        end
        task.wait(EGG_MOVE_REFRESH)
    end
    if not deliveryCanContinue(runId,char) then return false,'CANCELLED' end
    return false,'WALK TIMEOUT'
end

-- Fast walking is scoped to delivery only and restored even on an error.
-- Higher speeds are not a server-side bypass; game speed caps still apply.
local function deliveryWalkHomeFast(uid, runId, char)
    local hum = char:FindFirstChildOfClass('Humanoid')
    if not hum then return false,'HUMANOID MISSING' end
    local previousSpeed = hum.WalkSpeed
    local boosted = math.max(previousSpeed, EGG_DELIVERY_FAST_SPEED)
    if boosted > previousSpeed then
        pcall(function() hum.WalkSpeed = boosted end)
    end
    deliveryInfo.mode = 'FAST WALK'
    local ok, walkResult, why = pcall(deliveryWalkHome,uid,runId,char)
    -- Do not clobber unrelated server or user changes to WalkSpeed.
    if hum.Parent and boosted > previousSpeed
        and math.abs(hum.WalkSpeed - boosted) <= 0.05 then
        pcall(function() hum.WalkSpeed = previousSpeed end)
    end
    if not ok then return false,'FAST WALK ERROR: '..tostring(walkResult) end
    return walkResult, why
end

local function deliveryWaitForDeposit(uid, runId, char)
    deliveryStatus('WAITING FOR DEPOSIT')
    local deadline = os.clock() + EGG_DEPOSIT_WAIT
    local fieldMissingAt
    while deliveryCanContinue(runId,char) and os.clock() < deadline do
        local state = deliveryObserve(uid)
        if state == 'OWNED' then return true,'DEPOSIT CONFIRMED' end
        local root = char:FindFirstChild('HumanoidRootPart')
        if not root then return false,'CHARACTER LOST' end
        if not deliveryInBank(root.Position) then
            return false,'LEFT DEPOSIT AREA (POSSIBLE SERVER ROLLBACK)'
        end
        if state == 'MISSING' then
            fieldMissingAt = fieldMissingAt or os.clock()
        elseif state == 'DROPPED' or state == 'OTHER_CARRIER' then
            return false,'EGG '..state..' BEFORE DEPOSIT'
        end
        task.wait(0.15)
    end
    if deliveryOwnerHas(uid) then return true,'DEPOSIT CONFIRMED' end
    if fieldMissingAt then return false,'FIELD RECORD DISAPPEARED; CHECK INVENTORY' end
    return false,'CARRY STILL ACTIVE; SERVER DID NOT BANK'
end

local function deliveryUseSenaRuntime(uid, record, runId, char)
    local sena = env.__SenaV4EggRuntime
    if type(sena) ~= 'table' or sena.destroyed
        or type(sena.deliverCarriedEgg) ~= 'function' then
        return nil, 'SENA NOT LOADED'
    end
    deliveryInfo.mode = 'SENA RUNTIME'
    deliveryStatus('STARTING SENA RETURN')
    local ok, started = pcall(sena.deliverCarriedEgg, sena, uid, record)
    if not ok or started ~= true then return nil,'SENA DID NOT ACCEPT DELIVERY' end
    local deadline = os.clock()+35
    while deliveryCanContinue(runId,char) and os.clock()<deadline do
        local state = deliveryObserve(uid)
        if state == 'OWNED' then return true,'DEPOSIT CONFIRMED' end
        if sena._instantReturnToken == nil then break end
        task.wait(0.18)
    end
    -- Give owner data a moment to replicate before deciding what to do next.
    local finish = os.clock()+2
    while deliveryCanContinue(runId,char) and os.clock()<finish do
        if deliveryObserve(uid) == 'OWNED' then return true,'DEPOSIT CONFIRMED' end
        task.wait(0.1)
    end
    return nil,'SENA ENDED WITHOUT OWNER CONFIRMATION'
end

local function deliveryExecute(uid, runId)
    local char = getAliveCharacter()
    if not char or teleportBusy then return end
    setRouteBusy(true)
    deliveryInfo.uid = uid
    deliveryStatus('CONFIRMING E PICKUP')
    local record
    local deadline = os.clock()+3
    while deliveryCanContinue(runId,char) and os.clock()<deadline do
        local carrying, rec = deliveryIsCarrying(uid)
        if carrying then record=rec break end
        if deliveryObserve(uid)=='OWNED' then
            deliveryStatus('ALREADY DEPOSITED')
            setRouteBusy(false)
            return
        end
        task.wait(0.07)
    end
    if not record or not deliveryCanContinue(runId,char) then
        deliveryStatus('PICKUP NOT CONFIRMED',nil,true)
        setRouteBusy(false)
        return
    end
    -- Keep the old two-teleport behavior BEFORE running Sena's return.
    local savedPreviousPivot = char:GetPivot()
    local roundOK, roundReason = deliveryOldRoundTrip(uid,runId,char,savedPreviousPivot)
    if not roundOK then
        if deliveryCanContinue(runId,char) then
            deliveryStatus('ROUND TRIP FAILED',roundReason,true)
        end
        setRouteBusy(false)
        return
    end
    if deliveryObserve(uid) == 'OWNED' then
        deliveryStatus('DEPOSIT CONFIRMED')
        setRouteBusy(false)
        return
    end
    local carryingNow, refreshedRecord = deliveryIsCarrying(uid)
    if not carryingNow then
        deliveryStatus('DELIVERY PAUSED','CARRY NOT CONFIRMED AFTER RETURN',true)
        setRouteBusy(false)
        return
    end
    deliveryStatus('ROUND TRIP COMPLETE','STARTING DELIVERY')
    local result, reason = deliveryUseSenaRuntime(uid,refreshedRecord or record,runId,char)
    if result == true then
        deliveryStatus('DEPOSIT CONFIRMED')
        setRouteBusy(false)
        return
    end
    if not deliveryCanContinue(runId,char) then
        setRouteBusy(false)
        return
    end
    if deliveryObserve(uid) ~= 'CARRIED' then
        deliveryStatus('DEPOSIT UNCONFIRMED',reason,true)
        setRouteBusy(false)
        return
    end
    -- Standalone fallback: server-recognized walking, not local teleport hacks.
    deliveryStatus('WALKING TO DEPOSIT')
    local walking, why = deliveryWalkHomeFast(uid,runId,char)
    if walking == nil and why == 'ARRIVED' then
        walking, why = deliveryWaitForDeposit(uid,runId,char)
    elseif walking == false and why == 'FIELD EGG REMOVED; CHECK INVENTORY' then
        task.wait(1)
        if deliveryOwnerHas(uid) then walking,why=true,'DEPOSIT CONFIRMED' end
    end
    if deliveryCanContinue(runId,char) then
        if walking == true or deliveryObserve(uid)=='OWNED' then
            deliveryStatus('DEPOSIT CONFIRMED')
        else
            deliveryStatus('NOT CONFIRMED',why or 'UNKNOWN',true)
        end
    end
    setRouteBusy(false)
end

local function onManualEggCarry(packet)
    if not gui.Parent or settings.AutoEggReturn ~= true then return end
    if type(packet) ~= 'table' then return end
    if packet.IsCarrying == false then return end
    if packet.IsCarrying ~= true then return end
    local uid = packet.Uid
    if type(uid) ~= 'string' or uid == '' or teleportBusy or deliveringUid then return end
    local now = os.clock()
    if deliveryAttempted[uid] and now-deliveryAttempted[uid]<EGG_RETRY_DELAY then return end
    deliveryAttempted[uid] = now
    deliveringUid = uid
    deliveryRunId += 1
    local myRun = deliveryRunId
    task.spawn(function()
        local ok, err = pcall(deliveryExecute,uid,myRun)
        if not ok then
            deliveryStatus('RUNTIME ERROR', tostring(err),true)
            setRouteBusy(false)
        end
        if deliveringUid == uid then deliveringUid = nil end
    end)
end

local function deliveryScanCarried()
    if not eggStateModule then return end
    local get = eggStateModule.GetAreaEggSnapshot or eggStateModule.ReadFieldEggs
    if type(get) ~= 'function' then return end
    local ok, snapshot = pcall(get)
    if not ok or type(snapshot) ~= 'table' then return end
    local records = snapshot.Records or snapshot
    if type(records) ~= 'table' then return end
    for _, rec in pairs(records) do
        if type(rec)=='table' and type(rec.Uid)=='string'
            and rec.State=='Carried' and tonumber(rec.CarrierUserId)==player.UserId then
            onManualEggCarry({Uid=rec.Uid,IsCarrying=true})
            return
        end
    end
end

local function beginEggDeliveryWatcher()
    -- Old request-level observer is no longer connected to the hub callback.
    local oldWatcher = env.__SAE_Hub_EggObserver
    if type(oldWatcher)=='table' then oldWatcher.listener=nil oldWatcher.target=nil end
    local storage=game:GetService('ReplicatedStorage')
    local client=storage:WaitForChild('Client',12)
    local source=client and client:WaitForChild('EggState',12)
    if not gui.Parent then return end
    if not source then deliveryStatus('EGGSTATE NOT FOUND',nil,true) return end
    local ok, module=pcall(require,source)
    if not ok or type(module)~='table' then
        deliveryStatus('EGGSTATE LOAD FAILED',nil,true)
        return
    end
    eggStateModule=module
    if module.CarryChanged and type(module.CarryChanged.Connect)=='function' then
        local connected,conn=pcall(function()
            return module.CarryChanged:Connect(onManualEggCarry)
        end)
        if connected then deliveryConnection=conn
        else deliveryStatus('CARRY LISTENER FAILED',nil,true) end
    else
        deliveryStatus('NO CARRY SIGNAL; USING SNAPSHOT')
    end
    -- Recovery for carry already active when hub is opened. This never fires
    -- AskFieldEggCarry and never selects/approaches another player's egg.
    task.spawn(function()
        while gui.Parent and eggStateModule==module do
            if settings.AutoEggReturn and not teleportBusy and not deliveringUid then
                deliveryScanCarried()
            end
            task.wait(0.55)
        end
    end)
end

local function stopEggDelivery()
    deliveryRunId += 1
    deliveringUid=nil
    if deliveryConnection then
        pcall(function() deliveryConnection:Disconnect() end)
        deliveryConnection=nil
    end
    eggStateModule=nil
    if env.__SAE_Hub_DeliveryInfo==deliveryInfo then
        env.__SAE_Hub_DeliveryInfo=nil
    end
end

