local function isButterflyClaimPrompt(prompt)
    if not prompt then return false end
    local text = (tostring(prompt.ActionText) .. ' ' ..
        tostring(prompt.ObjectText) .. ' ' .. tostring(prompt.Name)):lower()
    return text:find('claim', 1, true) ~= nil
end

