-- V2.1-style route runner: use the saved pre-route pivot only for the
-- hidden egg-pickup round trip. Manual routes finish at route.Last.
-- This routine intentionally does NOT make a third teleport or continually
-- force the character's position after the second hop.
local function runRoute(route)
    if teleportBusy then
        setStatus('A TELEPORT ROUTE IS ALREADY RUNNING', true)
        return
    end

    local char = getAliveCharacter()
    if not char then
        setStatus('CHARACTER IS NOT READY', true)
        return
    end
    if typeof(route.First) ~= 'Vector3' then
        setStatus('INVALID FIRST WAYPOINT', true)
        return
    end
    if route.SingleOnly ~= true and route.ReturnPrevious ~= true and typeof(route.Last) ~= 'Vector3' then
        setStatus('INVALID SECOND WAYPOINT', true)
        return
    end

    -- Capture the entire original pivot BEFORE teleporting.
    -- This is only used as the destination when ReturnPrevious = true.
    local previous = char:GetPivot()
    local orientation = previous.Rotation
    local first = CFrame.new(route.First) * orientation
    -- SAFE ZONE is a single-step route and has no second destination.
    -- Only calculate a second CFrame for routes that actually need it.
    local destination
    if route.SingleOnly ~= true then
        if route.ReturnPrevious == true then
            destination = previous
        else
            destination = CFrame.new(route.Last) * orientation
        end
    end

    setRouteBusy(true)
    setStatus('TELEPORTING TO ' .. route.Name .. ' ...')

    task.spawn(function()
        if not moveTo(char, first) then
            setStatus('FIRST TELEPORT FAILED', true)
            setRouteBusy(false)
            return
        end

        print(string.format('[SAE Hub] %s: first -> (%.0f, %.0f, %.0f)',
            route.Name, route.First.X, route.First.Y, route.First.Z))
        if route.SingleOnly == true then
            setStatus('ROUTE COMPLETED: ' .. route.Name)
            print(string.format('[SAE Hub] %s: single-step route completed', route.Name))
            setRouteBusy(false)
            return
        end
        task.wait(route.Delay)

        if not gui.Parent then
            setRouteBusy(false)
            return
        end
        if player.Character ~= char then
            setStatus('CHARACTER CHANGED DURING TELEPORT', true)
            setRouteBusy(false)
            return
        end

        if moveTo(char, destination) then
            if route.ReturnPrevious == true then
                setStatus('RETURNED TO PREVIOUS LOCATION')
                print('[SAE Hub] AUTO SPAWN: returned to original pivot')
            else
                setStatus('ROUTE COMPLETED: ' .. route.Name)
                print(string.format('[SAE Hub] %s: second -> (%.0f, %.0f, %.0f)',
                    route.Name, route.Last.X, route.Last.Y, route.Last.Z))
                showSecondWaypointSplash()
            end
        else
            setStatus('SECOND TELEPORT FAILED', true)
        end
        setRouteBusy(false)
    end)
end
-- =======================================
-- AUTOMATIC EGG PICKUP REQUEST WATCHER
-- =======================================
-- This observes the game's own AskFieldEggCarry InvokeServer call.
-- Do NOT call the remote here. The Uid argument is dynamic and
-- only used as a non-empty request marker. We do not store a hardcoded ID.
-- A request is not proof that carrying succeeded; that would require
-- game-specific carry state or a documented response format.

local lastAutoRequest = -math.huge
local watcherState = 'CONNECTING'
local observerReference
local function onEggCarryRequest(uid)
    if not gui.Parent or not settings.AutoEggReturn then return end
    if type(uid) ~= 'string' or uid == '' then return end
    local now = os.clock()
    if now - lastAutoRequest < 1.5 then return end
    lastAutoRequest = now
    if teleportBusy then
        setStatus('EGG REQUEST DETECTED - ROUTE BUSY', true)
        return
    end
    setStatus('EGG PICKUP REQUEST DETECTED - AUTO SPAWN')
    runRoute(AUTO_EGG_ROUTE)
end

local function getHook(name)
    if type(env[name]) == 'function' then return env[name] end
    if name == 'hookmetamethod' then return type(hookmetamethod) == 'function' and hookmetamethod end
    if name == 'hookfunction' then return type(hookfunction) == 'function' and hookfunction end
    if name == 'getnamecallmethod' then return type(getnamecallmethod) == 'function' and getnamecallmethod end
    if name == 'newcclosure' then return type(newcclosure) == 'function' and newcclosure end
    return nil
end

local function installEggObserver(remote)
    local existing = env.__SAE_Hub_EggObserver
    if type(existing) == 'table' and existing.installed then
        existing.target = remote
        existing.listener = onEggCarryRequest
        observerReference = existing
        return true
    end

    local watcher = {target = remote, listener = onEggCarryRequest}
    local makeC = getHook('newcclosure')
    local function wrap(f)
        return makeC and makeC(f) or f
    end
    local hookMeta = getHook('hookmetamethod')
    local getMethod = getHook('getnamecallmethod')

    -- Preferred path: observes the namecall used by normal :InvokeServer().
    if hookMeta and getMethod then
        local original
        local function intercepted(self, ...)
            if self == watcher.target and getMethod() == 'InvokeServer' then
                local packet = select(1, ...)
                -- User example: InvokeServer(unpack({{Uid = 'random'}}))
                -- First argument is directly {Uid = ...}.
                local uid = type(packet) == 'table' and packet.Uid
                if type(uid) == 'string' and uid ~= '' then
                    local callback = watcher.listener
                    if callback then task.defer(callback, uid) end
                end
            end
            return original(self, ...)
        end
        local ok, previous = pcall(hookMeta, game, '__namecall', wrap(intercepted))
        if ok and type(previous) == 'function' then
            original = previous
            watcher.installed = true
            watcher.mode = 'namecall'
            env.__SAE_Hub_EggObserver = watcher
            observerReference = watcher
            return true
        end
    end

    -- Some executors offer hookfunction but not hookmetamethod.
    -- Not supported by every executor/RemoteFunction implementation.
    local hookFunction = getHook('hookfunction')
    if hookFunction then
        local original
        local function intercepted(self, ...)
            if self == watcher.target then
                local packet = select(1, ...)
                local uid = type(packet) == 'table' and packet.Uid
                if type(uid) == 'string' and uid ~= '' then
                    local callback = watcher.listener
                    if callback then task.defer(callback, uid) end
                end
            end
            return original(self, ...)
        end
        local ok, previous = pcall(hookFunction, remote.InvokeServer, wrap(intercepted))
        if ok and type(previous) == 'function' then
            original = previous
            watcher.installed = true
            watcher.mode = 'function'
            env.__SAE_Hub_EggObserver = watcher
            observerReference = watcher
            return true
        end
    end
    return false
end

local function beginEggWatcher()
    local ReplicatedStorage = game:GetService('ReplicatedStorage')
    local packages = ReplicatedStorage:WaitForChild('Packages', 12)
    local network = packages and packages:WaitForChild('Networking', 12)
    local remote = network and network:WaitForChild('RF/EggWorld/AskFieldEggCarry', 12)
    if not gui.Parent then return end
    if not remote or not remote:IsA('RemoteFunction') then
        watcherState = 'MISSING'
        updateEggWatchStatus()
        warn('[SAE Hub] AskFieldEggCarry RemoteFunction not found')
        return
    end
    local success = installEggObserver(remote)
    watcherState = success and 'READY' or 'UNAVAILABLE'
    updateEggWatchStatus()
    if success then
        print('[SAE Hub] Watching AskFieldEggCarry pickup requests; Uid is dynamic')
    else
        warn('[SAE Hub] Automatic pickup detection requires supported executor hook APIs')
    end
end

