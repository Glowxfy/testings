-- Check the Roblox inventory (Backpack), including an equipped Tool in
-- Character. Normalize punctuation/spaces to tolerate ButterflyNet variants.
local function hasButterflyNetTool()
    local function containsButterflyNet(container)
        if not container then return false end
        for _, item in ipairs(container:GetChildren()) do
            if item:IsA('Tool') and
                item.Name:lower():gsub('[^%w]', '') == 'butterflynet' then
                return true
            end
        end
        return false
    end
    return containsButterflyNet(player:FindFirstChildOfClass('Backpack'))
        or containsButterflyNet(player.Character)
end
local butterflyNetActive = false
local butterflyNetRunId = 0 -- invalidates previous asynchronous retry loops
